            renderPublicNews();
            renderCmsNews();
            showToast("公告已移除", "fa-trash-can", "text-red-400");
        }

        // Render Admin Tithing Logs & Dashboard
        function renderAdminData() {
            // Render Tithing Table
            const tbody = document.getElementById('admin-tithing-tbody');
            tbody.innerHTML = transactionsState.map(t => `
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="p-3.5 font-mono text-slate-500">${t.date}</td>
                    <td class="p-3.5 font-bold text-slate-800">${t.name}</td>
                    <td class="p-3.5"><span class="px-2 py-0.5 rounded bg-blue-50 text-church-blue font-semibold text-[11px]">${t.category}</span></td>
                    <td class="p-3.5 font-bold font-mono text-emerald-600">NT$ ${t.amount.toLocaleString()}</td>
                    <td class="p-3.5">${t.method}</td>
                    <td class="p-3.5"><span class="px-2 py-0.5 rounded-full ${t.status === '已入帳' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'} font-bold text-[10px]">${t.status}</span></td>
                    <td class="p-3.5">
                        <button onclick="showToast('正開立交易 ${t.id} 電子收據...', 'fa-file-invoice', 'text-sky-400')" class="text-church-blue hover:underline font-semibold">開立收據</button>
                    </td>
                </tr>
            `).join('');

            document.getElementById('tithing-count-badge').textContent = transactionsState.length;

            // Render Overview Recent List
            const recentContainer = document.getElementById('recent-transactions-list');
            recentContainer.innerHTML = transactionsState.slice(0, 5).map(t => `
                <div class="flex justify-between items-center p-2.5 bg-slate-50 rounded-xl text-xs">
                    <div>
                        <span class="font-bold text-slate-800 block">${t.name} (${t.category})</span>
                        <span class="text-[10px] text-slate-400">${t.method} • ${t.date}</span>
                    </div>
                    <span class="font-bold font-mono text-emerald-600">+NT$ ${t.amount.toLocaleString()}</span>
                </div>
            `).join('');

            // Update KPI totals
            const totalSum = transactionsState.reduce((sum, t) => sum + t.amount, 0);
            document.getElementById('kpi-total-amount').textContent = totalSum.toLocaleString();
            document.getElementById('kpi-count').textContent = `${transactionsState.length} 筆`;

            // Render Prayers List
            const prayerContainer = document.getElementById('admin-prayers-container');
            prayerContainer.innerHTML = prayerState.map(p => `
                <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-3">
                    <div class="flex justify-between items-center text-xs">
                        <span class="font-bold text-slate-800">${p.name} <span class="text-slate-400 font-normal">(${p.contact})</span></span>
                        <span class="px-2 py-0.5 rounded-full ${p.status === '待關懷' ? 'bg-sky-100 text-sky-800' : 'bg-slate-100 text-slate-600'} font-bold text-[10px]">${p.status}</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">${p.content}</p>
                    <div class="pt-2 border-t flex justify-between items-center text-[11px]">
                        <span class="text-slate-400">${p.date}</span>
                        ${p.status === '待關懷' ? `<button onclick="markPrayerDone(${p.id})" class="px-3 py-1 bg-sky-500 hover:bg-sky-600 text-white rounded-lg font-bold">標記已關懷代禱</button>` : `<span class="text-emerald-600 font-semibold"><i class="fa-solid fa-check mr-1"></i>已關懷</span>`}
                    </div>
                </div>
            `).join('');
        }

        function markPrayerDone(id) {
            prayerState = prayerState.map(p => p.id === id ? { ...p, status: '已代禱' } : p);
            renderAdminData();
            showToast("已更新為已關懷代禱狀態", "fa-check", "text-emerald-400");
        }

        // CSV Export Helper
        function exportReportCSV() {
            let csvContent = "data:text/csv;charset=utf-8,Transaction ID,Date,Donor Name,Category,Amount NT,Method,Status\n";
            transactionsState.forEach(t => {
                csvContent += `${t.id},${t.date},${t.name},${t.category},${t.amount},${t.method},${t.status}\n`;
            });
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "GraceChurch_Tithing_Report_2026.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("CSV 財務報表已開始下載！", "fa-file-csv", "text-emerald-400");
        }

        // Modal Handlers
        function openPrayerModal() { document.getElementById('prayer-modal').classList.remove('hidden'); }
        function closePrayerModal() { document.getElementById('prayer-modal').classList.add('hidden'); }
        function closeReceiptModal() { document.getElementById('receipt-modal').classList.add('hidden'); }
        function openNewsModal() { document.getElementById('cms-news-modal').classList.remove('hidden'); }
        function closeNewsModal() { document.getElementById('cms-news-modal').classList.add('hidden'); }

        function handlePrayerSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('pray-name').value;
            const contact = document.getElementById('pray-contact').value;
            const content = document.getElementById('pray-content').value;

            prayerState.unshift({
                id: Date.now(),
                name: name,
                contact: contact,
                content: content,
                status: '待關懷',
                date: new Date().toISOString().slice(0, 10)
            });

            closePrayerModal();
            renderAdminData();
            showToast("代禱需求已順利送出，關懷團隊將為您禱告！", "fa-hands-praying", "text-amber-300");
            e.target.reset();
        }

        function handleCmsNewsSubmit(e) {
            e.preventDefault();
            const title = document.getElementById('cms-news-title').value;
            const category = document.getElementById('cms-news-category').value;
            const content = document.getElementById('cms-news-content').value;

            newsState.unshift({
                id: Date.now(),
                title: title,
                category: category,
                content: content,
                date: new Date().toISOString().slice(0, 10)
            });

            closeNewsModal();
            renderPublicNews();
            renderCmsNews();
            showToast("最新消息已即時發布至前台！", "fa-bullhorn", "text-amber-400");
            e.target.reset();
        }

        function showToast(msg, icon = "fa-circle-check", color = "text-emerald-400") {
            const toast = document.getElementById('toast-box');
            document.getElementById('toast-text').textContent = msg;
            document.getElementById('toast-icon').className = `fa-solid ${icon} ${color} text-xl`;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3500);
        }

        // Chart.js Chart Initialization
        let givingChartInstance = null;
        function renderChart() {
            const ctx = document.getElementById('givingChart');
            if (!ctx) return;

            if (givingChartInstance) {
                givingChartInstance.destroy();
            }

            givingChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['5月', '6月', '7月', '8月', '9月', '10月 (本月)'],
                    datasets: [{
                        label: '奉獻總額 (NT$)',
                        data: [142000, 158000, 135000, 162000, 170000, 185000],
                        borderColor: '#1E3A8A',
                        backgroundColor: 'rgba(30, 58, 138, 0.08)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 } } },
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        }

        // Countdown Timer Logic for Sunday Service
        function startSundayTimer() {
            let seconds = 92120;
            setInterval(() => {
                seconds--;
                if (seconds < 0) seconds = 92120;
                const d = Math.floor(seconds / (3600*24));
                const h = Math.floor((seconds % (3600*24)) / 3600);
                const m = Math.floor((seconds % 3600) / 60);
                const s = Math.floor(seconds % 60);

                document.getElementById('timer-days').textContent = d.toString().padStart(2, '0');
                document.getElementById('timer-hours').textContent = h.toString().padStart(2, '0');
                document.getElementById('timer-mins').textContent = m.toString().padStart(2, '0');
                document.getElementById('timer-secs').textContent = s.toString().padStart(2, '0');
            }, 1000);
        }

        // Initialize App on Window Load
        window.onload = function() {
            renderPublicNews();
            renderCmsNews();
            renderAdminData();
            startSundayTimer();
        }
    </script>
</body>
</html>
