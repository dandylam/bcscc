<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>主恩教會 Grace Church - 網站與管理後台 Demo</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Serif+TC:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for Admin Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        church: {
                            blue: '#1E3A8A',
                            softblue: '#EFF6FF',
                            gold: '#D4AF37',
                            goldlight: '#FEF3C7',
                            golddark: '#B45309',
                            warmbg: '#FAF8F5',
                            text: '#334155',
                            heading: '#0F172A',
                            sidebar: '#0F172A'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['"Noto Serif TC"', 'serif'],
                    }
                }
            }
        }
    </script>
    <style>
        .hero-overlay {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 58, 138, 0.7) 100%);
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #D4AF37 0%, #F59E0B 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        /* Custom Scrollbar for Admin */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-church-warmbg text-church-text font-sans antialiased min-h-screen flex flex-col">

    <!-- Top Global Switcher Bar (Language & Admin/Public View Mode) -->
    <div class="bg-slate-900 text-white text-xs py-2 px-4 sticky top-0 z-50 flex flex-wrap justify-between items-center border-b border-slate-800 shadow-sm">
        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 bg-amber-500/20 text-amber-300 px-2.5 py-0.5 rounded-full border border-amber-500/30 font-medium">
                <i class="fa-solid fa-flask"></i> <span data-i18n="demoModeTag">DEMO 系統展示中</span>
            </span>
            <span class="hidden md:inline text-slate-400" data-i18n="demoWelcome">歡迎體驗主恩教會網站全功能與後台管理系統</span>
        </div>

        <div class="flex items-center gap-3">
            <!-- Mode Switcher (Public Site vs Admin Dashboard) -->
            <div class="bg-slate-800 rounded-lg p-0.5 flex items-center border border-slate-700">
                <button id="mode-public-btn" onclick="switchViewMode('public')" class="px-3 py-1 rounded-md text-xs font-semibold bg-church-blue text-white shadow-sm transition-all flex items-center gap-1">
                    <i class="fa-solid fa-globe"></i> <span data-i18n="modePublic">前台官網</span>
                </button>
                <button id="mode-admin-btn" onclick="switchViewMode('admin')" class="px-3 py-1 rounded-md text-xs font-semibold text-slate-300 hover:text-white transition-all flex items-center gap-1">
                    <i class="fa-solid fa-gauge-high"></i> <span data-i18n="modeAdmin">後台管理系統</span>
                    <span id="admin-badge" class="bg-red-500 text-white text-[10px] px-1.5 py-0.2 rounded-full font-bold ml-0.5">3</span>
                </button>
            </div>

            <!-- Language Switcher -->
            <button onclick="toggleLanguage()" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-md font-medium transition-colors flex items-center gap-1">
                <i class="fa-solid fa-language text-amber-400"></i>
                <span id="lang-label">English</span>
            </button>
        </div>
    </div>

    <!-- =================================================================== -->
    <!-- PUBLIC CHURCH WEBSITE SECTION (前台網站) -->
    <!-- =================================================================== -->
    <div id="public-site-container" class="flex-grow flex flex-col">
        
        <!-- Public Navigation Header -->
        <header class="bg-white/95 backdrop-blur-md shadow-sm sticky top-[37px] z-40 transition-all border-b border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-20">
                    <!-- Church Logo -->
                    <a href="#home" class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-church-blue flex items-center justify-center text-white shadow-md">
                            <i class="fa-solid fa-cross text-lg"></i>
                        </div>
                        <div>
                            <span class="text-xl font-bold font-serif text-church-heading block leading-none" data-i18n="churchName">主恩教會</span>
                            <span class="text-xs text-amber-600 font-semibold tracking-wider uppercase" data-i18n="churchSubName">Grace Church</span>
                        </div>
                    </a>

                    <!-- Nav Links -->
                    <nav class="hidden lg:flex items-center gap-7 font-medium text-slate-600 text-sm">
                        <a href="#home" class="hover:text-church-blue transition-colors py-2" data-i18n="navHome">主頁</a>
                        <a href="#services" class="hover:text-church-blue transition-colors py-2" data-i18n="navServices">主日崇拜</a>
                        <a href="#giving" class="hover:text-church-blue transition-colors py-2" data-i18n="navGiving">線上奉獻</a>
                        <a href="#prayer" class="hover:text-church-blue transition-colors py-2" data-i18n="navPrayer">代禱需求</a>
                        <a href="#news" class="hover:text-church-blue transition-colors py-2" data-i18n="navNews">最新消息</a>
                        <a href="#groups" class="hover:text-church-blue transition-colors py-2" data-i18n="navGroups">團契小組</a>
                    </nav>

                    <!-- Nav Actions -->
                    <div class="hidden sm:flex items-center gap-3">
                        <button onclick="openPrayerModal()" class="px-4 py-2 text-xs font-semibold text-church-blue bg-church-softblue hover:bg-blue-100 rounded-full transition-all">
                            <i class="fa-solid fa-hands-praying mr-1"></i><span data-i18n="btnPrayer">提出代禱</span>
                        </button>
                        <a href="#giving" class="px-5 py-2.5 text-xs font-bold text-slate-900 bg-amber-400 hover:bg-amber-500 rounded-full shadow-md transition-all flex items-center gap-1.5">
                            <i class="fa-solid fa-heart"></i> <span data-i18n="btnGiveNow">立即奉獻</span>
                        </a>
                    </div>

                    <button onclick="toggleMobileNav()" class="lg:hidden p-2 text-slate-600">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Nav -->
            <div id="mobile-nav" class="hidden lg:hidden bg-white border-b border-slate-100 px-4 py-4 space-y-3">
                <a href="#home" onclick="toggleMobileNav()" class="block text-slate-700 py-1" data-i18n="navHome">主頁</a>
                <a href="#services" onclick="toggleMobileNav()" class="block text-slate-700 py-1" data-i18n="navServices">主日崇拜</a>
                <a href="#giving" onclick="toggleMobileNav()" class="block text-slate-700 py-1" data-i18n="navGiving">線上奉獻</a>
                <a href="#prayer" onclick="toggleMobileNav()" class="block text-slate-700 py-1" data-i18n="navPrayer">代禱需求</a>
                <a href="#news" onclick="toggleMobileNav()" class="block text-slate-700 py-1" data-i18n="navNews">最新消息</a>
                <div class="pt-2 flex flex-col gap-2">
                    <button onclick="toggleMobileNav(); openPrayerModal();" class="w-full text-center py-2 text-xs font-bold text-church-blue bg-church-softblue rounded-lg" data-i18n="btnPrayer">提出代禱</button>
                    <a href="#giving" onclick="toggleMobileNav()" class="w-full text-center py-2 text-xs font-bold text-slate-900 bg-amber-400 rounded-lg" data-i18n="btnGiveNow">立即奉獻</a>
                </div>
            </div>
        </header>

        <!-- Hero Section -->
        <section id="home" class="relative min-h-[560px] flex items-center justify-center bg-slate-900 text-white overflow-hidden">
            <div class="absolute inset-0 z-0">
                <img src="https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&w=1920&q=80" 
                     alt="Sanctuary" 
                     class="w-full h-full object-cover object-center opacity-40"/>
                <div class="hero-overlay absolute inset-0"></div>
            </div>

            <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-16 space-y-6">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-amber-300 text-xs sm:text-sm border border-white/20">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span data-i18n="heroLiveTag">主日崇拜直播與實體聚會歡迎您</span>
                </div>

                <h1 class="text-3xl sm:text-5xl font-serif font-bold leading-tight tracking-wide">
                    <span data-i18n="heroTitle1">遇見基督愛與真理</span><br/>
                    <span class="gold-gradient-text" data-i18n="heroTitle2">建立溫暖喜樂的屬靈家園</span>
                </h1>

                <p class="text-sm sm:text-lg text-slate-200 max-w-2xl mx-auto font-light leading-relaxed" data-i18n="heroDesc">
                    無論您處於生命的何種階段，主恩教會都誠摯歡迎您。邀請您與我們一同敬拜，分享神的愛與盼望。
                </p>

                <!-- Dynamic Sunday Worship Timer/Countdown Box -->
                <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl max-w-md mx-auto border border-white/20 text-center">
                    <p class="text-xs text-amber-300 font-semibold mb-1" data-i18n="heroNextService">距離本週主日崇拜倒數</p>
                    <div class="flex justify-center gap-4 text-lg sm:text-xl font-bold font-mono">
                        <div><span id="timer-days">02</span><span class="text-xs font-sans text-slate-300 block font-normal" data-i18n="unitDays">天</span></div>:
                        <div><span id="timer-hours">14</span><span class="text-xs font-sans text-slate-300 block font-normal" data-i18n="unitHours">時</span></div>:
                        <div><span id="timer-mins">35</span><span class="text-xs font-sans text-slate-300 block font-normal" data-i18n="unitMins">分</span></div>:
                        <div><span id="timer-secs">20</span><span class="text-xs font-sans text-slate-300 block font-normal" data-i18n="unitSecs">秒</span></div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
                    <a href="#giving" class="w-full sm:w-auto px-7 py-3.5 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold rounded-full shadow-lg transition-all text-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-heart"></i> <span data-i18n="btnGiveNow">線上奉獻支持</span>
                    </a>
                    <a href="#services" class="w-full sm:w-auto px-7 py-3.5 bg-white/15 hover:bg-white/25 text-white border border-white/30 rounded-full transition-all text-sm flex items-center justify-center gap-2">
                        <i class="fa-regular fa-clock"></i> <span data-i18n="btnServiceTimes">聚會時間與地點</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Enhanced Multi-Option Online Giving / Tithing Section -->
        <section id="giving" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
                <span class="text-xs uppercase tracking-widest text-amber-600 font-bold block" data-i18n="givingSub">ONLINE TITHING & OFFERING</span>
                <h2 class="text-3xl font-serif font-bold text-church-heading" data-i18n="givingTitle">線上奉獻專區</h2>
                <p class="text-slate-500 text-sm leading-relaxed" data-i18n="givingDesc">
                    「各人要隨本心所酌定的，不要作難，不要勉強，因為捐得樂意的人是神所喜愛的。」（林後 9:7）
                </p>
            </div>

            <!-- Giving Form Interactive Card -->
            <div class="bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden max-w-4xl mx-auto">
                <div class="p-6 sm:p-10 space-y-8">

                    <!-- Step 1: Select Tithing Category -->
                    <div class="space-y-3">
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500" data-i18n="step1">Step 1：選擇奉獻項目</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <button type="button" onclick="selectCategory(this, '十一奉獻')" class="cat-btn active py-3 px-4 rounded-xl border border-church-blue bg-church-softblue text-church-blue font-bold text-xs sm:text-sm text-center transition-all">
                                <i class="fa-solid fa-hands-holding-circle block text-lg mb-1"></i>
                                <span data-i18n="catTithe">十一奉獻</span>
                            </button>
                            <button type="button" onclick="selectCategory(this, '建堂基金')" class="cat-btn py-3 px-4 rounded-xl border border-slate-200 hover:border-slate-300 text-slate-600 font-bold text-xs sm:text-sm text-center transition-all">
                                <i class="fa-solid fa-church block text-lg mb-1"></i>
                                <span data-i18n="catBuilding">建堂基金</span>
                            </button>
                            <button type="button" onclick="selectCategory(this, '宣教宣道')" class="cat-btn py-3 px-4 rounded-xl border border-slate-200 hover:border-slate-300 text-slate-600 font-bold text-xs sm:text-sm text-center transition-all">
                                <i class="fa-solid fa-earth-americas block text-lg mb-1"></i>
                                <span data-i18n="catMissions">宣教宣道</span>
                            </button>
                            <button type="button" onclick="selectCategory(this, '慈惠救助')" class="cat-btn py-3 px-4 rounded-xl border border-slate-200 hover:border-slate-300 text-slate-600 font-bold text-xs sm:text-sm text-center transition-all">
                                <i class="fa-solid fa-hand-holding-heart block text-lg mb-1"></i>
                                <span data-i18n="catMercy">慈惠救助</span>
                            </button>
                        </div>
                    </div>

                    <!-- Step 2: Select or Enter Amount -->
                    <div class="space-y-3">
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500" data-i18n="step2">Step 2：選擇或輸入金額 (NT$)</label>
                        <div class="grid grid-cols-3 sm:grid-cols-5 gap-3">
                            <button type="button" onclick="selectAmount(500, this)" class="amount-btn py-2.5 rounded-xl border border-slate-200 font-bold text-slate-700 text-sm hover:border-amber-400">NT$ 500</button>
                            <button type="button" onclick="selectAmount(1000, this)" class="amount-btn active py-2.5 rounded-xl border-2 border-amber-500 bg-amber-50 font-bold text-amber-800 text-sm">NT$ 1,000</button>
                            <button type="button" onclick="selectAmount(3000, this)" class="amount-btn py-2.5 rounded-xl border border-slate-200 font-bold text-slate-700 text-sm hover:border-amber-400">NT$ 3,000</button>
                            <button type="button" onclick="selectAmount(5000, this)" class="amount-btn py-2.5 rounded-xl border border-slate-200 font-bold text-slate-700 text-sm hover:border-amber-400">NT$ 5,000</button>
                            <button type="button" onclick="enableCustomAmount(this)" class="amount-btn py-2.5 rounded-xl border border-slate-200 font-bold text-slate-700 text-sm hover:border-amber-400 col-span-2 sm:col-span-1" data-i18n="amtCustom">自訂金額</button>
                        </div>
                        <input type="number" id="custom-amount-input" placeholder="請輸入金額 (如: 10000)" class="hidden w-full px-4 py-2.5 rounded-xl border border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm mt-2">
                    </div>

                    <!-- Step 3: Interactive Payment Method Selection Tabs -->
                    <div class="space-y-3">
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500" data-i18n="step3">Step 3：選擇付款方式</label>

                        <!-- Payment Method Tabs -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 border-b border-slate-100 pb-2">
                            <button type="button" onclick="switchPaymentTab('applepay')" id="tab-applepay" class="pay-tab active py-2.5 px-3 rounded-xl bg-slate-900 text-white font-semibold text-xs flex items-center justify-center gap-2 shadow-sm transition-all">
                                <i class="fa-brands fa-apple text-base"></i> Apple / Google Pay
                            </button>
                            <button type="button" onclick="switchPaymentTab('card')" id="tab-card" class="pay-tab py-2.5 px-3 rounded-xl bg-slate-100 text-slate-600 font-semibold text-xs flex items-center justify-center gap-2 hover:bg-slate-200 transition-all">
                                <i class="fa-regular fa-credit-card text-base"></i> <span data-i18n="payCard">線上信用卡</span>
                            </button>
                            <button type="button" onclick="switchPaymentTab('linepay')" id="tab-linepay" class="pay-tab py-2.5 px-3 rounded-xl bg-slate-100 text-slate-600 font-semibold text-xs flex items-center justify-center gap-2 hover:bg-slate-200 transition-all">
                                <i class="fa-solid fa-qrcode text-base text-emerald-600"></i> LINE Pay / 掃碼
                            </button>
                            <button type="button" onclick="switchPaymentTab('bank')" id="tab-bank" class="pay-tab py-2.5 px-3 rounded-xl bg-slate-100 text-slate-600 font-semibold text-xs flex items-center justify-center gap-2 hover:bg-slate-200 transition-all">
                                <i class="fa-solid fa-building-columns text-base text-blue-600"></i> <span data-i18n="payBank">銀行轉帳</span>
                            </button>
                        </div>

                        <!-- Tab Content 1: Apple Pay / Quick Express -->
                        <div id="pay-content-applepay" class="pay-content p-5 bg-slate-50 rounded-2xl border border-slate-200 text-center space-y-4">
                            <div class="max-w-xs mx-auto space-y-2">
                                <i class="fa-brands fa-apple text-4xl text-slate-800"></i>
                                <h4 class="font-bold text-slate-800 text-sm" data-i18n="applePayTitle">快速指紋/面容快捷奉獻</h4>
                                <p class="text-xs text-slate-500" data-i18n="applePayDesc">無需輸入繁瑣卡號，使用裝置錢包一秒完成安全奉獻。</p>
                            </div>
                            <button type="button" onclick="processQuickGiving('Apple Pay / Google Pay')" class="w-full sm:w-auto px-8 py-3 bg-black hover:bg-slate-800 text-white font-bold text-sm rounded-xl transition-all shadow-md inline-flex items-center justify-center gap-2">
                                <i class="fa-brands fa-apple text-lg"></i> <span data-i18n="btnPayExpress">使用 Pay 快速奉獻</span>
                            </button>
                        </div>

                        <!-- Tab Content 2: Credit / Debit Card Gateway -->
                        <div id="pay-content-card" class="pay-content hidden p-5 bg-slate-50 rounded-2xl border border-slate-200 space-y-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-semibold text-slate-600 mb-1" data-i18n="cardHolder">持卡人姓名</label>
                                    <input type="text" id="card-name" placeholder="John Doe" class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-sm bg-white">
                                </div>
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-semibold text-slate-600 mb-1" data-i18n="cardNumber">信用卡卡號</label>
                                    <div class="relative">
                                        <input type="text" id="card-number" placeholder="4532 •••• •••• 8899" maxlength="19" class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-sm bg-white font-mono">
                                        <i class="fa-brands fa-cc-visa absolute right-3 top-2.5 text-slate-400 text-lg"></i>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-600 mb-1" data-i18n="cardExp">有效期限 (MM/YY)</label>
                                    <input type="text" placeholder="12/28" maxlength="5" class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-sm bg-white font-mono">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-600 mb-1">CVC / CVV</label>
                                    <input type="password" placeholder="•••" maxlength="4" class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-sm bg-white font-mono">
                                </div>
                            </div>
                            <button type="button" onclick="processQuickGiving('Credit Card')" class="w-full py-3 bg-church-blue hover:bg-blue-900 text-white font-bold text-sm rounded-xl transition-all shadow">
                                <i class="fa-solid fa-lock mr-1"></i> <span data-i18n="btnConfirmCard">確認信用卡安全奉獻</span>
                            </button>
                        </div>

                        <!-- Tab Content 3: LINE Pay / QR Code Scan -->
                        <div id="pay-content-linepay" class="pay-content hidden p-5 bg-slate-50 rounded-2xl border border-slate-200 text-center space-y-3">
                            <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full">LINE Pay / 電子支付專用</span>
                            <div class="w-36 h-36 mx-auto bg-white p-2 rounded-xl shadow-inner border border-slate-200 flex items-center justify-center">
                                <!-- Dynamic QR Code Demo Image -->
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=GraceChurchGiving" alt="Giving QR Code" class="w-full h-full object-contain">
                            </div>
                            <p class="text-xs text-slate-500" data-i18n="qrDesc">請開啟 LINE Pay 或相機掃描上方 QR Code 完成付款。</p>
                            <button type="button" onclick="processQuickGiving('LINE Pay')" class="px-6 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow">
                                <span data-i18n="btnScanned">我已完成掃碼奉獻</span>
                            </button>
                        </div>

                        <!-- Tab Content 4: Bank Wire Transfer -->
                        <div id="pay-content-bank" class="pay-content hidden p-5 bg-slate-50 rounded-2xl border border-slate-200 space-y-3">
                            <div class="bg-white p-4 rounded-xl border border-slate-200 text-xs font-mono space-y-2">
                                <div class="flex justify-between border-b pb-1">
                                    <span class="text-slate-500 font-sans" data-i18n="bankName">銀行名稱：</span>
