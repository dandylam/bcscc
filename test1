        // Handle Quick Giving Process & Dynamic Receipt Generation
        function processQuickGiving(methodName) {
            const donorNameInput = document.getElementById('donor-name').value.trim() || '無名氏弟兄/姊妹';
            const customAmt = document.getElementById('custom-amount-input').value;
            const finalAmt = customAmt ? parseInt(customAmt) : currentAmount;

            const now = new Date();
            const dateStr = now.toISOString().slice(0, 10);
            const timeStr = `${dateStr} ${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}`;
            const transactionId = `GR-${dateStr.replace(/-/g,'')}-${Math.floor(100+Math.random()*900)}`;

            // Create new transaction log in state
            const newLog = {
                id: transactionId,
                date: timeStr,
                name: donorNameInput,
                category: currentCategory,
                amount: finalAmt,
                method: methodName,
                status: '已入帳'
            };

            transactionsState.unshift(newLog);
            renderAdminData();

            // Populate Modal Receipt
            document.getElementById('rec-id').textContent = transactionId;
            document.getElementById('rec-date').textContent = dateStr;
            document.getElementById('rec-name').textContent = donorNameInput;
            document.getElementById('rec-cat').textContent = currentCategory;
            document.getElementById('rec-method').textContent = methodName;
            document.getElementById('rec-amount').textContent = `NT$ ${finalAmt.toLocaleString()}`;

            // Show Receipt Modal
            document.getElementById('receipt-modal').classList.remove('hidden');
        }

